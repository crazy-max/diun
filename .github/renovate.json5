{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigestsToSemver",
    "helpers:githubDigestChangelogs"
  ],
  "enabledManagers": [
    "gomod",
    "github-actions",
    "custom.regex"
  ],
  "postUpdateOptions": ["gomodTidy", "gomodVendor"],
  "prHourlyLimit": 0,
  "minimumReleaseAge": "2 days",
  "internalChecksFilter": "strict",
  "labels": ["kind/dependencies", "bot"],
  "semanticCommits": "disabled",
  "commitMessagePrefix": "deps:",
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/.*\\.ya?ml$/"],
      "matchStrings": [
        "(?:^|\\r?\\n)[ \\t]*(?:-[ \\t]+|runner:[ \\t]+)(?<depName>ubuntu|macos|windows)-(?<currentValue>[0-9][a-zA-Z0-9.-]*)"
      ],
      "datasourceTemplate": "github-runners",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/.github/workflows/.*\\.ya?ml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))?[ \\t]*\\r?\\n[ \\t]*\\w+:[ \\t]*\"(?<currentValue>[^\"]+)\""
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["**/*Dockerfile*"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))?[ \\t]*\\r?\\n[ \\t]*ARG[ \\t]+\\w+=\"?(?<currentValue>[^\\s\"]+)\"?"
      ]
    }
  ],
  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "matchDepNames": ["github/codeql-action"],
      "groupName": "codeql-actions"
    },
    {
      "matchUpdateTypes": ["major", "minor", "patch"],
      "commitMessageAction": "bump",
      "commitMessageTopic": "{{{depName}}}",
      "commitMessageExtra": "from {{{replace '^v' '' currentValue}}} to {{{replace '^v' '' newValue}}}"
    }
  ],
  "ignoreDeps": [
    "github.com/hashicorp/nomad/api",
    "github.com/sirupsen/logrus",
    "k8s.io/api",
    "k8s.io/apimachinery"
  ]
}
